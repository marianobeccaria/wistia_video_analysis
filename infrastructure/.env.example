# AWS deployment target
AWS_ACCOUNT_ID=<your-aws-account-id>
AWS_REGION=us-east-1
ENVIRONMENT=dev
PROJECT_NAME=wistia-video-analysis

# Wistia
WISTIA_API_BASE_URL=https://api.wistia.com/modern
# Local development only. Production jobs should read the token from AWS Secrets Manager.
WISTIA_API_TOKEN=<your-local-wistia-api-token>
WISTIA_SECRET_NAME=/wistia-video-analysis/dev/wistia-api-token
WISTIA_MEDIA_IDS=gskhw4w4lm,v08dlrgr7v

# S3 / data lake
S3_BUCKET_NAME=<your-s3-bucket-name>
BRONZE_PREFIX=bronze/wistia
SILVER_PREFIX=silver/wistia
GOLD_PREFIX=gold/wistia

# Glue / Athena / CDK
GLUE_ROLE_NAME=wistia-video-analysis-dev-glue-role
GLUE_DATABASE_NAME=wistia_video_analytics
GLUE_WORKFLOW_NAME=wistia-video-analysis-dev-workflow
INGESTION_JOB_NAME=wistia-video-analysis-dev-ingest-bronze
BRONZE_TO_SILVER_JOB_NAME=wistia-video-analysis-dev-bronze-to-silver
SILVER_TO_GOLD_JOB_NAME=wistia-video-analysis-dev-silver-to-gold
GOLD_QUALITY_JOB_NAME=wistia-video-analysis-dev-gold-quality
LOG_RETENTION_DAYS=30

# Scheduling
PIPELINE_SCHEDULE=cron(0 2 * * ? *)
PIPELINE_SCHEDULE_ENABLED=false
