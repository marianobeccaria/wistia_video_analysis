# AWS deployment target
AWS_ACCOUNT_ID=<your-AWS_ACCOUNT_ID>
AWS_REGION=us-east-1
ENVIRONMENT=dev
PROJECT_NAME=wistia-video-analysis

# Wistia
WISTIA_API_BASE_URL=https://api.wistia.com/v1
WISTIA_API_TOKEN=<your-WISTIA_API_TOKEN>
WISTIA_SECRET_NAME=/wistia-video-analysis/dev/wistia-api-token
WISTIA_MEDIA_IDS=<your-WISTIA_MEDIA_IDS>

# S3 / data lake
S3_BUCKET_NAME=<your-S3_BUCKET_NAME>
BRONZE_PREFIX=bronze/wistia
SILVER_PREFIX=silver/wistia
GOLD_PREFIX=gold/wistia

# Glue / Athena
GLUE_DATABASE_NAME=wistia_video_analytics
GLUE_RAW_CRAWLER_NAME=wistia-raw-crawler
GLUE_TRANSFORM_JOB_NAME=wistia-transform-job

# Scheduling
PIPELINE_SCHEDULE=cron(0 2 * * ? *)

